{
	"$schema": "schema.json",
	"tcp_addrs": [
		{
			"addr": "127.0.0.1:4000",
			"proxy_protocol": false
		},
		{
			"addr": "127.0.0.1:4001",
			"proxy_protocol": true
		}
	],
	"prometheus_addr": "127.0.0.1:9001",
	"rules": [
		{
			"path": {
				"start": "/"
			},
			"upstream": "server"
		},
		{
			"path": {
				"start": "/posts"
			},
			"upstream": "server",
			"cache": {
				"methods": [
					"GET"
				]
			}
		}
	],
	"upstreams": {
		"server": {
			"addr": "http://127.0.0.1:2999",
			"max_connections": 10,
			"authentication": {
				"exclude": [
					"/",
					"/posts"
				],
				"source": {
					"upstream": {
						"name": "server",
						"path": "/"
					}
				}
			}
		}
	}
}